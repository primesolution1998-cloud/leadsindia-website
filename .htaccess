RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Clean accidental homepage test/chat query parameters from visible URL.
RewriteCond %{REQUEST_URI} ^/$
RewriteCond %{QUERY_STRING} (^|&)(v=[^&]*|utm_source=chatgpt\.com)(&|$) [NC]
RewriteRule ^$ / [R=301,L,QSD]

# Redirect legacy .html URLs to clean public routes.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+properties\.html(?:[?\s]) [NC]
RewriteRule ^properties\.html$ /properties [R=301,L]

RewriteCond %{THE_REQUEST} \s/+loans\.html(?:[?\s]) [NC]
RewriteRule ^loans\.html$ /loans [R=301,L]

RewriteCond %{THE_REQUEST} \s/+software\.html(?:[?\s]) [NC]
RewriteRule ^software\.html$ /software [R=301,L]

RewriteCond %{THE_REQUEST} \s/+list-property\.html(?:[?\s]) [NC]
RewriteRule ^list-property\.html$ /list-property [R=301,L]

RewriteCond %{THE_REQUEST} \s/+search-property(?:\.html)?(?:[?\s]) [NC]
RewriteRule ^search-property(?:\.html)?$ /properties [R=301,L]

# Campaign landing homepage wrapper.
RewriteRule ^$ index.php [L]

# Clean public routes.
RewriteRule ^list-property/?$ owner/list-property.php [L]
RewriteRule ^properties/?$ properties-page.php [L]
RewriteRule ^loans/?$ loans.php [L]
RewriteRule ^software/?$ software.php [L]

# Ensure static HTML pages render correctly.
AddType text/html .html .htm
<IfModule mod_mime.c>
  AddType text/html .html .htm
  AddType text/css .css
  AddType application/javascript .js
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>
